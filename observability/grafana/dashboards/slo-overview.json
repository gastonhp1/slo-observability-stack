{
  "uid": "slo-overview",
  "title": "SLO overview",
  "description": "Error budgets and burn rates for every SLO defined in slo/specs. Generated by tools/dashboards/build.py.",
  "tags": [
    "slo",
    "sre"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "slo",
        "label": "SLO",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(slo:info, slo_id)",
          "refId": "slo"
        },
        "definition": "label_values(slo:info, slo_id)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "SLO alerts",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\", slo_id=~\"$slo\"}",
        "titleFormat": "{{alertname}} ({{severity}})",
        "textFormat": "{{slo_id}}",
        "step": "30s"
      }
    ]
  },
  "links": [
    {
      "title": "SLO overview",
      "type": "link",
      "url": "/d/slo-overview",
      "keepTime": true
    },
    {
      "title": "Service RED",
      "type": "link",
      "url": "/d/service-red",
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Where are we against the objective",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 1
    },
    {
      "type": "table",
      "title": "SLOs",
      "description": "One row per SLO. Budget remaining is for the 30d period; burn rate 1 = spending the budget exactly by the end of the period.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "info",
          "expr": "slo:info{slo_id=~\"$slo\"}",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table",
          "exemplar": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "objective",
          "expr": "slo:objective:ratio{slo_id=~\"$slo\"}",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table",
          "exemplar": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "sli",
          "expr": "1 - slo:sli_error:ratio_rate30d{slo_id=~\"$slo\"}",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table",
          "exemplar": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "budget",
          "expr": "slo:period_error_budget_remaining:ratio{slo_id=~\"$slo\"}",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table",
          "exemplar": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "burn5m",
          "expr": "slo:current_burn_rate:ratio{slo_id=~\"$slo\"}",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table",
          "exemplar": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "burn1h",
          "expr": "slo:sli_error:ratio_rate1h{slo_id=~\"$slo\"} / on (slo_id) group_left slo:error_budget:ratio{slo_id=~\"$slo\"}",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table",
          "exemplar": false
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "slo_window": true,
              "team": false,
              "tier": true,
              "slo_service": true,
              "slo_name": true,
              "slo_description": true,
              "slo_objective": true,
              "Value #info": true
            },
            "renameByName": {
              "slo_id": "SLO",
              "team": "Team",
              "Value #objective": "Objective",
              "Value #sli": "SLI (30d)",
              "Value #budget": "Budget left (30d)",
              "Value #burn5m": "Burn rate 5m",
              "Value #burn1h": "Burn rate 1h"
            },
            "indexByName": {
              "slo_id": 0,
              "team": 1,
              "Value #objective": 2,
              "Value #sli": 3,
              "Value #budget": 4,
              "Value #burn5m": 5,
              "Value #burn1h": 6
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Objective|SLI.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Budget left (30d)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.25
                    },
                    {
                      "color": "green",
                      "value": 0.5
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Burn rate.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "x"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 6
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Budget left (30d)",
            "desc": false
          }
        ]
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 7
      },
      "id": 2
    },
    {
      "type": "row",
      "title": "How fast is the budget going",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 1
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Burn rate (5m and 1h windows)",
      "description": "Dashed lines: 6x and 14.4x, the page thresholds. A page needs BOTH the short and the long window above the line, which is what filters out short spikes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "slo:current_burn_rate:ratio{slo_id=~\"$slo\"}",
          "legendFormat": "{{slo_id}} 5m",
          "instant": false,
          "range": true,
          "format": "time_series",
          "exemplar": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "slo:sli_error:ratio_rate1h{slo_id=~\"$slo\"} / on (slo_id) group_left slo:error_budget:ratio",
          "legendFormat": "{{slo_id}} 1h",
          "instant": false,
          "range": true,
          "format": "time_series",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "x",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Error budget remaining (30d)",
      "description": "Below 0 the SLO is breached for the period: the error budget policy freezes risky changes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "slo:period_error_budget_remaining:ratio{slo_id=~\"$slo\"}",
          "legendFormat": "{{slo_id}}",
          "instant": false,
          "range": true,
          "format": "time_series",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "id": 5
    },
    {
      "type": "row",
      "title": "Signals behind the SLIs",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Error ratio by window",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "slo:sli_error:ratio_rate5m{slo_id=~\"$slo\"}",
          "legendFormat": "{{slo_id}} 5m",
          "instant": false,
          "range": true,
          "format": "time_series",
          "exemplar": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "slo:sli_error:ratio_rate1h{slo_id=~\"$slo\"}",
          "legendFormat": "{{slo_id}} 1h",
          "instant": false,
          "range": true,
          "format": "time_series",
          "exemplar": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "slo:sli_error:ratio_rate6h{slo_id=~\"$slo\"}",
          "legendFormat": "{{slo_id}} 6h",
          "instant": false,
          "range": true,
          "format": "time_series",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "id": 7
    },
    {
      "type": "table",
      "title": "Firing SLO and platform alerts",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\"}",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table",
          "exemplar": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "alertstate": true
            },
            "indexByName": {
              "alertname": 0,
              "severity": 1,
              "slo_id": 2
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "page": {
                        "color": "red",
                        "index": 0
                      },
                      "ticket": {
                        "color": "orange",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "id": 8
    }
  ]
}
