    {
      "type": "logs",
      "title": "Warnings and errors",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{service_name=\"$service\"} | severity_text=~\"(?i)(warn|warning|error|critical)\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 10
      },
      "id": 11
    },
    {
      "type": "table",
      "title": "Recent error traces",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "limit": 20,
          "tableType": "traces",
          "query": "{resource.service.name=\"$service\" && status=error}"
        }
      ],
      "options": {
        "showHeader": true
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 10
