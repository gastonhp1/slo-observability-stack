{
  "uid": "service-red",
  "title": "Service RED",
  "description": "Rate, errors and duration per service, with exemplars, logs and traces. Generated by tools/dashboards/build.py.",
  "tags": [
    "red",
    "services"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
