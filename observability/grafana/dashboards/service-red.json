      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"$service\"}[1m])))",
          "legendFormat": "p50",
          "instant": false,
          "range": true,
          "format": "time_series",
          "exemplar": false
